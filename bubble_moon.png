import React, { useCallback, useEffect, useRef, useState } from "react";
import {
  View,
  Text,
  StyleSheet,
  Pressable,
  Platform,
  ScrollView,
  useWindowDimensions,
  LayoutAnimation,
  UIManager,
} from "react-native";

// Enable LayoutAnimation on Android
if (Platform.OS === "android" && UIManager.setLayoutAnimationEnabledExperimental) {
  UIManager.setLayoutAnimationEnabledExperimental(true);
}
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { router, useFocusEffect } from "expo-router";
import * as Haptics from "expo-haptics";
import AsyncStorage from "@react-native-async-storage/async-storage";

import { useTheme } from "@/context/ThemeContext";
import { useApp } from "@/context/AppContext";
import { useSubscription } from "@/context/SubscriptionContext";
import { useAmbient } from "@/context/AmbientAudioContext";
import { useLanguage } from "@/context/LanguageContext";

import { ParticleField } from "@/components/ParticleField";
import { BottomShelf, SHELF_H } from "@/components/BottomShelf";
import { HomeScene } from "@/components/HomeScene";
import { IntroOverlay, hasSeenIntro, markIntroSeen } from "@/components/IntroOverlay";
import { HiddenActivationWrapper } from "@/components/HiddenActivation";
import { LanguagePicker } from "@/components/LanguagePicker";
import { FairyTutorialOverlay } from "@/components/FairyTutorialOverlay";

import { getSession } from "@/data/sessions";
import { computeAdaptiveSession, getAdaptiveLabel, computeUserLevel, computeAdaptiveDuration } from "@/data/adaptiveSession";
import { DurationPickerSheet } from "@/components/DurationPickerSheet";
import { useSensors } from "@/hooks/useSensors";

const KEY_FIRST_PAYWALL = "@fbrs_first_paywall_seen";

type AccordionEntry = { icon: string; title: string; color: string; body: string };

// ── Vertical accordion — 3 tabs côte à côte + panneau commun ─────────────────
function VerticalAccordion({
  items,
  open,
  onToggle,
  onTabRowHeight,
  isDark = true,
}: {
  items: AccordionEntry[];
  open: number | null;
  onToggle: (i: number) => void;
  onTabRowHeight?: (h: number) => void;
  isDark?: boolean;
}) {
  const tabBaseBg = isDark ? "#ffffff06" : "#00000006";
  return (
    <View style={vaStyles.wrap}>
      {/* ── Tab row ── */}
      <View
        style={vaStyles.tabRow}
        onLayout={(e) => onTabRowHeight?.(e.nativeEvent.layout.height)}
      >
        {items.map((item, i) => {
          const active = open === i;
          return (
            <Pressable
              key={i}
              onPress={() => {
                LayoutAnimation.configureNext({
                  duration: 240,
                  update: { type: "spring", springDamping: 0.8 },
                  create: { type: "easeInEaseOut", property: "opacity" },
                });
                if (Platform.OS !== "web") Haptics.selectionAsync();
                onToggle(i);
              }}
              style={[
                vaStyles.tab,
                { borderColor: item.color + (active ? "55" : "20"), backgroundColor: active ? item.color + "12" : tabBaseBg },
              ]}
            >
              <Text style={[vaStyles.tabIcon, { color: item.color }]}>{item.icon}</Text>
              <Text
                style={[vaStyles.tabTitle, { color: item.color + (active ? "ff" : "99") }]}
                numberOfLines={2}
              >
                {item.title}
              </Text>
              <View style={[vaStyles.activeDot, { backgroundColor: active ? item.color : "transparent" }]} />
            </Pressable>
          );
        })}
      </View>

    </View>
  );
}

const vaStyles = StyleSheet.create({
  wrap: {
    paddingHorizontal: 14,
    position: "relative",
    overflow: "visible",
  },
  tabRow: {
    flexDirection: "row",
    gap: 7,
  },
  tab: {
    flex: 1,
    alignItems: "center",
    paddingVertical: 10,
    paddingHorizontal: 6,
    borderRadius: 12,
    borderWidth: 1,
    backgroundColor: "#ffffff06",
    gap: 5,
  },
  tabIcon: {
    fontSize: 18,
  },
  tabTitle: {
    fontSize: 9,
    fontWeight: "700",
    letterSpacing: 0.5,
    textAlign: "center",
    textTransform: "uppercase",
    lineHeight: 12,
  },
  activeDot: {
    width: 4,
    height: 4,
    borderRadius: 2,
    marginTop: 2,
  },
});

// ── Theme palettes ─────────────────────────────────────────────────────────────
const NIGHT = {
  bg:      "#060614",
  primary: "#00d4ff",   // electric cyan
  sub:     "#0048aa",
};
const DAY = {
  bg:      "#e5e4ed",   // gris clair légèrement lavandé
  primary: "#5418c8",   // violet profond — haute lisibilité sur fond clair
  sub:     "#7c3aed",   // violet moyen
};

// ── Main screen ───────────────────────────────────────────────────────────────
export default function HomeScreen() {
  const { isDark, toggle } = useTheme();
  const insets   = useSafeAreaInsets();
  const { height: screenH } = useWindowDimensions();
  const { profile, records } = useApp();
  const sensors  = useSensors(true);
  const { canStartSession, recordSessionStart } = useSubscription();
  const ambient  = useAmbient();
  const { t }    = useLanguage();

  const ACCORDION = [
    { icon: "⚡", title: t.accordionTorchTitle,    color: "#ffd166", body: t.accordionTorchBody },
    { icon: "◎", title: t.accordionBinauralTitle,  color: "#b48fff", body: t.accordionBinauralBody },
    { icon: "◈", title: t.accordionSchumannTitle,  color: "#00e5ff", body: t.accordionSchumannBody },
  ];

  const [showIntro,         setShowIntro]         = useState(false);
  const [showTutorial,      setShowTutorial]      = useState(false);
  const [openAccordion,     setOpenAccordion]     = useState<number | null>(null);
  const [pickerSessionId,   setPickerSessionId]   = useState<string | null>(null);
  const [showDurationPicker, setShowDurationPicker] = useState(false);
  const [tabRowHeight,      setTabRowHeight]      = useState(90);
  const firstRunRef = useRef(false);

  useEffect(() => {
    if (Platform.OS === "web") return;
    hasSeenIntro().then((seen) => {
      if (!seen) {
        setShowIntro(true);
        firstRunRef.current = true;
      }
    });
  }, []);

  useFocusEffect(
    useCallback(() => {
      if (!ambient.isMuted) ambient.fadeIn();
    }, [ambient])
  );

  const handleIntroClose = useCallback(async () => {
    await markIntroSeen();
    setShowIntro(false);
    // First-run: show paywall intro once
    if (firstRunRef.current) {
      firstRunRef.current = false;
      try {
        const seen = await AsyncStorage.getItem(KEY_FIRST_PAYWALL);
        if (!seen) {
          await AsyncStorage.setItem(KEY_FIRST_PAYWALL, "1");
          router.push("/paywall");
        }
      } catch {}
    }
  }, []);

  // Tap sur une bulle → ouvre le sélecteur de durée
  const handleStart = useCallback((sessionId: string) => {
    if (!canStartSession()) { router.push("/paywall"); return; }
    setPickerSessionId(sessionId);
    setShowDurationPicker(true);
  }, [canStartSession]);

  // Durée choisie → lance la séance avec la durée retenue
  const handleDurationSelect = useCallback(async (sessionId: string, durationSec: number) => {
    setShowDurationPicker(false);
    await recordSessionStart();
    ambient.fadeOut(() => router.push(`/active?id=${sessionId}&duration=${durationSec}`));
  }, [recordSessionStart, ambient]);

  const topPad = Platform.OS === "web" ? 44 : insets.top;
  const botPad = Platform.OS === "web" ? 26 : insets.bottom;

  const palette    = isDark ? NIGHT : DAY;
  const bg         = palette.bg;
  const primaryCol = palette.primary;
  const textMuted  = isDark ? "#ffffff35" : "#00000030";

  // Derived surface colors — dark vs light mode
  const bannerBg       = isDark ? "#07071aee" : "#ffffffd4";
  const bannerBorder   = isDark ? primaryCol + "20" : primaryCol + "30";
  const panelBg        = isDark ? "#060614f0" : "#f5f2ffee";
  const panelTextColor = isDark ? "#ffffff80" : "#2e0a72";

  const voyages = profile.totalVoyages;

  // ── Adaptive session ──────────────────────────────────────────────────────
  const adaptive = computeAdaptiveSession(sensors, records, profile, t);
  const adaptiveName = getAdaptiveLabel(adaptive, t);
  const adaptiveSession = getSession(adaptive.sessionId);

  // ── User learning level ───────────────────────────────────────────────────
  const levelInfo = computeUserLevel(voyages, t);

  return (
    <View style={[styles.screen, { backgroundColor: bg }]}>
      {/* ── Ambient particle field ── */}
      <ParticleField isDark={isDark} />

      {/* ── Slim topbar ── */}
      <View style={[styles.topBar, { paddingTop: topPad + 4 }]}>

        {/* Brand — 7 rapid taps → dev menu · long-press → intro ── */}
        <HiddenActivationWrapper onLongPress={() => setShowIntro(true)}>
          <View style={styles.brandRow}>
            <View style={styles.brand}>
              <View style={[styles.brandDot, { backgroundColor: primaryCol }]} />
              <View>
                <Text style={[styles.brandName, { color: primaryCol }]}>B·R·S</Text>
                <Text style={[styles.brandSub, { color: primaryCol + "80" }]}>FÉE BELETTE REBOOT SYSTEM</Text>
                <Text style={[styles.brandSubTiny, { color: primaryCol + "55" }]}>BIOADAPTIVE RELAXATION SYSTEM</Text>
              </View>
            </View>
            <Pressable
              onPress={() => {
                if (Platform.OS !== "web") Haptics.selectionAsync();
                setShowIntro(true);
              }}
              style={[styles.voyagesBadge, { borderColor: primaryCol + "30", backgroundColor: primaryCol + "12" }]}
              hitSlop={6}
            >
              <Text style={[styles.voyagesNum, { color: primaryCol }]}>{voyages}</Text>
              <Text style={[styles.voyagesLabel, { color: primaryCol + "99" }]}>
                {voyages === 1 ? t.sessionSingular : t.freeSessions}
              </Text>
            </Pressable>
          </View>
        </HiddenActivationWrapper>

        {/* Right controls */}
        <View style={styles.topRight}>
          <LanguagePicker />
          <Pressable
            onPress={() => {
              if (Platform.OS !== "web") Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
              ambient.toggle();
            }}
            style={[styles.iconBtn, { borderColor: primaryCol + "35" }]}
          >
            <Text style={{ fontSize: 13, color: ambient.isMuted ? textMuted : primaryCol }}>
              {ambient.isMuted ? "♪" : "♫"}
            </Text>
          </Pressable>
          <Pressable
            onPress={() => {
              if (Platform.OS !== "web") Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
              toggle();
            }}
            style={[styles.iconBtn, { borderColor: primaryCol + "35" }]}
          >
            <Text style={{ fontSize: 13, color: primaryCol }}>
              {isDark ? "☀" : "☾"}
            </Text>
          </Pressable>
        </View>
      </View>

      {/* ── Bubble scene — fixed, always visible ── */}
      {/* pointerEvents="box-none": le conteneur ne capture aucune touche,
          seuls les Pressable (fée, bulles) à l'intérieur restent actifs */}
      <View
        style={[styles.sceneFixed, { height: Math.round(screenH * 0.51) - 20, zIndex: 10, pointerEvents: "box-none" }]}
      >
        <HomeScene
          onStart={handleStart}
          isDark={isDark}
          onFairyPress={() => setShowTutorial(true)}
        />
      </View>

      {/* ── Info banner — niveau + raison + actions ── */}
      <View style={[styles.infoBanner, { backgroundColor: bannerBg, borderTopColor: bannerBorder, borderBottomColor: bannerBorder }]}>
        <View style={styles.infoBannerRow}>
          {/* Level info */}
          <View style={styles.infoBannerLeft}>
            {levelInfo.emoji ? (
              <>
                <Text style={styles.infoBannerEmoji}>{levelInfo.emoji}</Text>
                <Text style={[styles.infoBannerLabel, { color: primaryCol + "cc" }]}>{levelInfo.label}</Text>
              </>
            ) : (
              <Text style={[styles.infoBannerLabel, { color: primaryCol + "55" }]}>BLACKLACE ISLAND</Text>
            )}
          </View>
          {/* Progress bar */}
          {levelInfo.progressRatio > 0 && (
            <View style={[styles.infoBannerBar, { backgroundColor: primaryCol + "20" }]}>
              <View style={[
                styles.infoBannerBarFill,
                { width: `${Math.round(levelInfo.progressRatio * 100)}%` as any, backgroundColor: primaryCol + "bb" },
              ]} />
            </View>
          )}
          {/* Action buttons */}
          <View style={styles.infoBannerActions}>
            <Pressable
              onPress={() => {
                if (Platform.OS !== "web") Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
                toggle();
              }}
              style={styles.infoBannerBtn}
              hitSlop={8}
            >
              <Text style={{ fontSize: 14, color: primaryCol + "cc" }}>{isDark ? "☀" : "☾"}</Text>
            </Pressable>
            <Pressable
              onPress={() => router.push("/profile")}
              style={styles.infoBannerBtn}
              hitSlop={8}
            >
              <Text style={{ fontSize: 14, color: primaryCol + "99" }}>◉</Text>
            </Pressable>
          </View>
        </View>
        {adaptive.reason ? (
          <Text style={[styles.infoBannerReason, { color: isDark ? "#ffffff50" : primaryCol + "80" }]} numberOfLines={1}>
            ◈ {adaptive.reason}
          </Text>
        ) : null}
      </View>

      {/* ── Science accordions — scrollable independently ── */}
      <ScrollView
        style={styles.accordionScroll}
        contentContainerStyle={{ flexGrow: 1, justifyContent: "flex-end", paddingBottom: SHELF_H + botPad + 16 }}
        showsVerticalScrollIndicator={false}
        keyboardShouldPersistTaps="handled"
        bounces
      >
        <VerticalAccordion
          items={ACCORDION}
          open={openAccordion}
          onToggle={(i) => setOpenAccordion((prev) => (prev === i ? null : i))}
          onTabRowHeight={setTabRowHeight}
          isDark={isDark}
        />
      </ScrollView>

      {/* ── Accordion content panel — overlay fixe au-dessus des boutons ── */}
      {openAccordion !== null && (
        <View
          style={[
            styles.accordionPanel,
            {
              bottom: SHELF_H + botPad + 16 + tabRowHeight + 8,
              borderColor: ACCORDION[openAccordion].color + "30",
              backgroundColor: panelBg,
            },
          ]}
        >
          <ScrollView
            style={{ maxHeight: 160 }}
            showsVerticalScrollIndicator={false}
            bounces={false}
          >
            <Text style={[styles.accordionPanelText, { color: panelTextColor }]}>
              {ACCORDION[openAccordion].body}
            </Text>
          </ScrollView>
        </View>
      )}

      {/* ── Bottom shelf ── */}
      <BottomShelf
        primaryColor={primaryCol}
        secondaryColor={palette.sub}
        isDark={isDark}
        sensors={sensors}
        voyages={voyages}
        streak={profile.currentStreak}
        sessionName={adaptiveName}
        sessionDuration={adaptiveSession?.durationLabel ?? "—"}
        adaptiveReason={adaptive.reason}
        levelLabel={levelInfo.label}
        levelEmoji={levelInfo.emoji}
        levelProgressRatio={levelInfo.progressRatio}
        onStart={() => handleStart(adaptive.sessionId)}
        onProfile={() => router.push("/profile")}
      />

      {/* ── Intro overlay (first run + on brand tap) ── */}
      {showIntro && (
        <IntroOverlay onDone={handleIntroClose} />
      )}

      {/* ── Fairy tutorial overlay ── */}
      <FairyTutorialOverlay
        visible={showTutorial}
        onClose={() => setShowTutorial(false)}
        primaryColor={primaryCol}
      />

      {/* ── Duration picker sheet ── */}
      <DurationPickerSheet
        visible={showDurationPicker}
        session={pickerSessionId ? (() => {
          const s = getSession(pickerSessionId);
          return s ? {
            id:          s.id,
            name:        s.name,
            subtitle:    s.subtitle,
            scienceHook: s.scienceHook,
            colors:      s.colors,
          } : null;
        })() : null}
        adaptiveDuration={pickerSessionId
          ? computeAdaptiveDuration(sensors, records, profile.totalVoyages)
          : 300}
        onSelect={handleDurationSelect}
        onClose={() => setShowDurationPicker(false)}
        isDark={isDark}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  screen: { flex: 1 },

  topBar: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
    paddingHorizontal: 20,
    paddingBottom: 4,
    zIndex: 10,
  },

  brandRow: { flexDirection: "row", alignItems: "center", gap: 10 },
  brand:    { flexDirection: "row", alignItems: "center", gap: 7 },
  brandDot: { width: 5, height: 5, borderRadius: 3 },
  brandName:   { fontSize: 10, fontWeight: "800", letterSpacing: 4 },
  brandSub:    { fontSize: 5.5, fontWeight: "700", letterSpacing: 1.4, textTransform: "uppercase", marginTop: 1 },
  brandSubTiny:{ fontSize: 4.5, fontWeight: "500", letterSpacing: 1.0, textTransform: "uppercase" },

  voyagesBadge: {
    flexDirection: "row", alignItems: "baseline", gap: 3,
    paddingHorizontal: 7, paddingVertical: 3, borderRadius: 8, borderWidth: 1,
  },
  voyagesNum:   { fontSize: 11, fontWeight: "700", letterSpacing: 0.3 },
  voyagesLabel: { fontSize: 8, fontWeight: "500", letterSpacing: 0.8, textTransform: "uppercase" },

  topRight: { flexDirection: "row", alignItems: "center", gap: 8 },
  iconBtn: {
    width: 28, height: 28, borderRadius: 9, borderWidth: 1,
    alignItems: "center", justifyContent: "center",
  },

  sceneFixed: {
    overflow: "visible",
    width: "100%",
  },

  infoBanner: {
    zIndex: 2,
    width: "100%",
    paddingHorizontal: 14,
    paddingVertical: 10,
    gap: 5,
    borderTopWidth: 0.5,
    borderBottomWidth: 0.5,
  },
  infoBannerRow: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
    width: "100%",
  },
  infoBannerLeft: {
    flexDirection: "row",
    alignItems: "center",
    gap: 7,
    flex: 1,
  },
  infoBannerActions: {
    flexDirection: "row",
    alignItems: "center",
    gap: 10,
    marginLeft: 8,
  },
  infoBannerBtn: {
    width: 28,
    height: 28,
    borderRadius: 8,
    alignItems: "center",
    justifyContent: "center",
  },
  infoBannerEmoji: { fontSize: 20 },
  infoBannerLabel: {
    fontSize: 13,
    fontWeight: "700",
    letterSpacing: 1.6,
    textTransform: "uppercase",
    textAlign: "center",
  },
  infoBannerBar: {
    flex: 1,
    height: 3,
    borderRadius: 2,
    overflow: "hidden" as const,
    maxWidth: 80,
  },
  infoBannerBarFill: { height: "100%" as any, borderRadius: 2 },
  infoBannerReason: {
    fontSize: 10,
    fontWeight: "500",
    letterSpacing: 0.4,
    color: "#ffffff50",
    paddingLeft: 26,
  },

  accordionPanel: {
    position: "absolute",
    left: 14,
    right: 14,
    borderWidth: 1,
    borderRadius: 12,
    paddingHorizontal: 14,
    paddingVertical: 12,
    zIndex: 5,
  },
  accordionPanelText: {
    fontSize: 12,
    lineHeight: 18,
    letterSpacing: 0.2,
  },

  accordionScroll: {
    flex: 1,
  },

  accordionWrap: {
    paddingHorizontal: 18,
    paddingTop: 6,
    gap: 7,
  },
});
